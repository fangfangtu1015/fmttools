export function translate(locale: LocaleCode, key: string) {
  if (locale === 'en') return EN[key] ?? key
  return PARTIAL[locale]?.[key] ?? EN[key] ?? key
}

export const LOCALE_STORAGE_KEY = 'converttools-ui-locale'
